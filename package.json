{
  "name": "babymoon",
  "version": "1.0.3",
  "private": true,
  "description": "Private, browser-based P2P baby monitor using WebRTC, STUN and Socket.IO signaling.",
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "NODE_ENV=development node --watch server.js",
    "check": "node --check server.js && node --check public/app.js && node --check public/sw.js",
    "test": "node --test --test-reporter=spec",
    "verify": "npm run check && npm test"
  },
  "dependencies": {
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "qrcode": "^1.5.4",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "socket.io-client": "^4.8.1"
  }
}
